# =============================================================================
# React Docgen AI — Configuration via Environment Variables
# =============================================================================
# Copy this file to .env and adjust values:
#   cp .env.example .env
#
# CLI arguments always take priority over env vars.
# Usage: CLI arg > env var > built-in default
# =============================================================================

# ── LLM (HTTP) ──────────────────────────────────────────────────────────────
# URL для локального LLM сервера (по умолчанию: http://localhost:8000/completions)
LLM_API_URL=http://localhost:8000/completions

# Максимальное количество токенов в ответе LLM (по умолчанию: 4096)
LLM_MAX_TOKENS=4096

# Температура генерации, от 0.0 до 1.0 (по умолчанию: 0.1)
LLM_TEMPERATURE=0.1

# ── OpenCode SDK ────────────────────────────────────────────────────────────
# Модель для OpenCode в формате provider/model
# Примеры:
#   openrouter/anthropic/claude-sonnet-4
#   openrouter/openai/gpt-4o
#   anthropic/claude-3-haiku
OPENCODE_DEFAULT_MODEL=

# ── Общие настройки проекта ─────────────────────────────────────────────────
# Исходная директория или файл (аналог --src)
DOCGEN_SRC=

# Выходная директория для результатов (по умолчанию: ./ai-output)
DOCGEN_OUT=./ai-output

# Расширения файлов для обработки (по умолчанию: js,jsx,ts,tsx)
DOCGEN_EXTENSIONS=js,jsx,ts,tsx
