{
  "name": "react-docgen-ai",
  "version": "1.0.0",
  "description": "CLI tool for auto-commenting and generating docs for React apps using local LLM",
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "react-docgen-ai": "./bin/react-docgen-ai.js"
  },
  "scripts": {
    "build": "tsc && bun run copy-prompts",
    "clean": "bun -e \"const fs = require('fs'); fs.rmSync('dist', {recursive: true, force: true});\"",
    "copy-prompts": "bun -e \"const fs = require('fs'); fs.cpSync('src/prompts', 'dist/prompts', {recursive: true});\"",
    "dev": "tsc --watch",
    "start": "bun dist/cli.js",
    "test": "bun test __tests__/ast-extractor.test.ts __tests__/compact-format.test.ts __tests__/component-graph.test.ts __tests__/file-utils.test.ts __tests__/prompt-loader.test.ts __tests__/llm-client.test.ts",
    "test:mock": "bun test __tests__/annotator.test.ts __tests__/generate-graph.test.ts",
    "test:all": "bun test __tests__/",
    "prepublishOnly": "bun run build && bun run test:all",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "@opencode-ai/sdk": "^1.16.2",
    "commander": "^11.1.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.8.0",
    "typescript": "^5.2.0"
  },
  "keywords": [
    "react",
    "documentation",
    "ai",
    "cli",
    "typescript",
    "docgen"
  ],
  "author": "AI Docgen",
  "license": "MIT",
  "packageManager": "bun@1.3.14"
}
